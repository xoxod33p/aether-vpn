{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherVPN",
  "version": "0.1.0",
  "identifier": "com.aethervpn.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AetherVPN",
        "url": "index.html",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1", "iptables"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libappindicator-gtk3", "iptables"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
