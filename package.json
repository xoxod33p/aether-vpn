{
  "name": "vpn",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:installer": "tauri build && node scripts/update-installer.js",
    "build:portable": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --release && node scripts/update-installer.js",
    "test:backend": "cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
